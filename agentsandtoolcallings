# Import necessary modules for demonstration

import random
from typing import Any, Dict

# Define abstract Tool class with a general interface for processing tasks

class Tool:
    def process(self, data: Any) -> str:
        raise NotImplementedError("Process method must be implemented.")

# Define a tool that is ideal for heavy computations

class HeavyComputationTool(Tool):
    def process(self, data: Any) -> str:
        # Simulate heavy computation
        return f"Processed heavy computation on {data}"

# Define a tool designed for handling simple lookup queries

class SimpleLookupTool(Tool):
    def process(self, data: Any) -> str:
        # Simulate a simple lookup
        return f"Performed simple lookup on {data}"

# Agent class responsible for selecting the correct tool based on task requirements

class Agent:
    def __init__(self):
        self.tools: Dict[str, Tool] = {
            "heavy_computation": HeavyComputationTool(),
            "simple_lookup": SimpleLookupTool()
        }
    
    # Function to decide which tool to call based on task complexity.
    def select_tool(self, task: Dict[str, Any]) -> Tool:
        # For demonstration, if task complexity is high, choose heavy computation tool.
        # However, a wrong selection could occur if the logic is incorrectly implemented.
        complexity = task.get("complexity", "low")
        
        # Wrong tool selection scenario:
        # If complexity is "low" but the agent mistakenly evaluates conditions wrongly,
        # it might mistakenly choose HeavyComputationTool.
        if complexity == "high":
            return self.tools["heavy_computation"]
        elif complexity == "low":
            # Intentional error: by mistake, a random wrong call may occur
            if random.choice([True, False]):
                # Wrong tool selected randomly
                return self.tools["heavy_computation"]
            else:
                return self.tools["simple_lookup"]
        else:
            # Default to simple lookup if criteria is ambiguous
            return self.tools["simple_lookup"]
    
    # Main function to handle the task by calling the selected tool
    def handle_task(self, task: Dict[str, Any]) -> str:
        tool = self.select_tool(task)
        result = tool.process(task.get("data", "undefined data"))
        return result

# Example usage:

if __name__ == "__main__":
    agent = Agent()
    
    # Define sample tasks with varying complexity
    tasks = [
        {"complexity": "low", "data": "quick search string"},
        {"complexity": "high", "data": "complex dataset analysis"}
    ]
    
    for task in tasks:
        output = agent.handle_task(task)
        print(f"Task: {task} -> Output: {output}")
