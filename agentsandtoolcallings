// agent.js
// This script demonstrates how an agent makes use of a tool to fetch and display weather information.

const { getWeather } = require('./weatherTool');

/**
 * Agent function that processes user queries regarding weather data.
 * @param {string} city - The city name entered by the user.
 */
async function processWeatherQuery(city) {
  try {
    console.log(`Agent: Processing weather query for ${city}...`);
    
    // Calling the tool to get weather data from the real API.
    const weatherData = await getWeather(city);
    
    // Process and display the results (this can be further integrated into dialog output).
    console.log(`Agent: The current temperature in ${weatherData.name} is ${weatherData.main.temp}°C with ${weatherData.weather[0].description}.`);
  } catch (error) {
    // Handle any errors encountered during tool execution.
    console.error('Agent: Unable to retrieve weather information:', error.message);
  }
}

// Example usage: the agent processes a query for the city "London".
processWeatherQuery('London');
