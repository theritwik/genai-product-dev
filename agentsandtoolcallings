// Import necessary modules
const express = require('express');
const bodyParser = require('body-parser');
const { v4: uuidv4 } = require('uuid'); // For generating unique IDs

const app = express();
const port = 3000;

// Middleware to parse JSON bodies
app.use(bodyParser.json());

// In-memory store for pending approvals
const approvalQueue = new Map();

/**
 * Simulate an automated agent triggering a sensitive action
 * that requires human approval.
 */
function triggerSensitiveAction(actionData) {
  // Generate a unique ID for this request
  const approvalId = uuidv4();

  // Store the request in the approval queue with a pending status
  approvalQueue.set(approvalId, { status: 'pending', data: actionData });
  
  // Here, notify the human reviewer via email, dashboard, or other means
  console.log(`Action triggered. Awaiting approval. Approval ID: ${approvalId}`);
  
  return approvalId;
}

/**
 * Endpoint for agents to trigger a new action.
 * This simulates the automation initiating a workflow.
 */
app.post('/trigger-action', (req, res) => {
  const actionData = req.body;
  
  if (!actionData || Object.keys(actionData).length === 0) {
    return res.status(400).json({ error: 'Action data is required.' });
  }
  
  const approvalId = triggerSensitiveAction(actionData);
  res.status(202).json({
    message: 'Action pending human approval.',
    approvalId: approvalId
  });
});

/**
 * Endpoint for human reviewers to approve or reject the pending action.
 * Input: approvalId and decision ("approve" or "reject").
 */
app.post('/process-approval', (req, res) => {
  const { approvalId, decision } = req.body;
  
  // Validate request payload
  if (!approvalId || !decision) {
    return res.status(400).json({ error: 'Approval ID and decision are required.' });
  }
  
  if (!approvalQueue.has(approvalId)) {
    return res.status(404).json({ error: 'Approval ID not found.' });
  }
  
  // Update the approval status
  const approvalEntry = approvalQueue.get(approvalId);
  approvalEntry.status = decision === 'approve' ? 'approved' : 'rejected';
  approvalQueue.set(approvalId, approvalEntry);
  
  // Notify or trigger post-approval processing
  console.log(`Approval ID ${approvalId} has been ${approvalEntry.status}.`);
  
  res.json({ message: `Action ${approvalEntry.status}.`, details: approvalEntry });
});

/**
 * Endpoint to query the current status of a pending action.
 */
app.get('/approval-status/:id', (req, res) => {
  const approvalId = req.params.id;
  
  if (!approvalQueue.has(approvalId)) {
    return res.status(404).json({ error: 'Approval ID not found.' });
  }
  
  res.json({ approvalId: approvalId, status: approvalQueue.get(approvalId).status });
});

// Start the Express server
app.listen(port, () => {
  console.log(`Human Approval Workflow service is running on port ${port}`);
});
