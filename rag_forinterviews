import java.io.File;
import java.io.IOException;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.text.PDFTextStripper;

public class PDFParser {

    /**
     * Extracts text content from a PDF file.
     *
     * @param filePath the path to the PDF file.
     * @return the extracted text as a String.
     * @throws IOException if the file cannot be read.
     */
    public static String extractTextFromPDF(String filePath) throws IOException {
        // Load the PDF document from the file path.
        File file = new File(filePath);
        try (PDDocument document = PDDocument.load(file)) {
            // Create a PDFTextStripper instance to extract text.
            PDFTextStripper pdfStripper = new PDFTextStripper();
            // Extract text from the document.
            return pdfStripper.getText(document);
        }
    }

    public static void main(String[] args) {
        // Example file path to a PDF file
        String pdfFilePath = "sample.pdf";
        try {
            // Extract text from the PDF and print it.
            String extractedText = extractTextFromPDF(pdfFilePath);
            System.out.println("Extracted Text:");
            System.out.println(extractedText);
        } catch (IOException e) {
            System.err.println("Error reading the PDF file: " + e.getMessage());
        }
    }
}
Code Explanation
The code uses the Apache PDFBox library to load a PDF document from a specified file path.
A PDFTextStripper object is used to process the PDF’s internal page streams and extract the text content.
Proper resource management is handled by using a try-with-resources block ensuring the PDF document is closed after processing.
Any exceptions (e.g., file not found) are caught and handled appropriately.
