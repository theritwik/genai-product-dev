import os
from typing import List, Dict

def load_documents_from_directory(directory_path: str) -> List[Dict]:
    """
    Ingest documents from the specified directory.
    
    Each document is represented as a dictionary with keys:
    - 'filename': Name of the file
    - 'content': Text content of the file (UTF-8 decoded)
    - 'metadata': A dictionary of metadata (e.g., file size, path)
    
    Args:
        directory_path (str): Path to the directory containing documents.
    
    Returns:
        List[Dict]: A list of document dictionaries ready for further processing.
    """
    documents = []
    
    # Iterate over files in the given directory
    for filename in os.listdir(directory_path):
        file_path = os.path.join(directory_path, filename)
        # Process only files (ignore directories)
        if os.path.isfile(file_path):
            try:
                # Open file in read mode. Assuming text files; for PDFs/other formats, use dedicated libraries.
                with open(file_path, 'r', encoding='utf-8') as file:
                    content = file.read().strip()
                
                # Collect metadata
                file_stats = os.stat(file_path)
                metadata = {
                    'size_bytes': file_stats.st_size,
                    'path': file_path
                }
                
                documents.append({
                    'filename': filename,
                    'content': content,
                    'metadata': metadata
                })
            except Exception as e:
                # Log or handle exceptions as needed
                print(f"Error reading {file_path}: {e}")

    return documents

# Example usage:

if __name__ == '__main__':
    # Path to your document directory
    documents_directory = './documents'
    loaded_documents = load_documents_from_directory(documents_directory)
    
    # Output summary of loaded documents
    for doc in loaded_documents:
        print(f"Loaded {doc['filename']} (size: {doc['metadata']['size_bytes']} bytes)")
Explanation of the Code
Directory Scanning:
The function iterates over every file in the provided directory. It ensures that only files (not directories) are processed.

Content Extraction:
For each file, the code attempts to open the file and read its content. This example assumes text files encoded in UTF-8. For other document types (PDFs, DOCX), you would integrate specific parsing libraries.

Metadata Collection:
The file’s size and full path are captured using Python's built-in OS library. This metadata can be useful for debugging, relevance scoring, or auditing.

Error Handling:
Errors during file reading (e.g., permission issues, encoding errors) are caught and printed. In production, a more robust logging system should be implemented.

