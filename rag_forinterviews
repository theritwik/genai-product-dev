package citations;

import java.util.Objects;

/**
 * A class to represent a citation with essential details.
 */
public class Citation {
    private final String author;
    private final String title;
    private final String publication;
    private final int year;

    public Citation(String author, String title, String publication, int year) {
        this.author = author;
        this.title = title;
        this.publication = publication;
        this.year = year;
    }

    public String getAuthor() {
        return author;
    }

    public String getTitle() {
        return title;
    }

    public String getPublication() {
        return publication;
    }

    public int getYear() {
        return year;
    }

    @Override
    public String toString() {
        return author + ". " + title + ". " + publication + ", " + year + ".";
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Citation)) return false;
        Citation citation = (Citation) o;
        return year == citation.year &&
               Objects.equals(author, citation.author) &&
               Objects.equals(title, citation.title) &&
               Objects.equals(publication, citation.publication);
    }

    @Override
    public int hashCode() {
        return Objects.hash(author, title, publication, year);
    }
}
