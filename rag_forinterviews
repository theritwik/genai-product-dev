# Generate the embedding vector from the document

embedding_vector = model.encode(document_text).tolist()  # Convert numpy array to list for storage

# Step 4: Upsert the Embedding into the Vector Database

# The upsert operation adds or updates a vector entry identified by a unique ID.

document_id = 'doc1'
metadata = {'text': document_text}

# Upsert the vector along with its metadata

upsert_response = index.upsert([
    (document_id, embedding_vector, metadata)
])
print("Upsert response:", upsert_response)

# Step 5: Querying the Vector Database

# For demonstration, we compute the embedding for a query and perform a similarity search.

query_text = "How is retrieval augmented generation implemented?"
query_embedding = model.encode(query_text).tolist()

# Perform similarity search (returning top 3 results)

query_response = index.query(queries=[query_embedding], top_k=3, include_metadata=True)
