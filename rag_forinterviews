# Import necessary libraries

import re
from sentence_transformers import SentenceTransformer
from typing import List

# Initialize the Sentence Transformer model

# In a production system, you might choose a model that balances accuracy and speed

model = SentenceTransformer('all-MiniLM-L6-v2')

def preprocess_text(text: str) -> str:
    """
    Clean the input text by removing extra spaces and non-alphanumeric characters
    that may affect chunk boundaries.
    """
    # Remove extra whitespace and unwanted characters
    text = re.subr'+', ' ', text
    return text.strip()

def chunk_text(text: str, chunk_size: int = 512, overlap: int = 50) -> List[str]:
    """
    Divide the text into chunks with a specified token size and overlap.
    This basic method splits text based on space separation while trying
    to maintain the flow by overlapping adjacent chunks.
    
    Parameters:
        text (str): The raw text to be chunked.
        chunk_size (int): Maximum number of words per chunk.
        overlap (int): Number of words to overlap between consecutive chunks.
        
    Returns:
        List[str]: A list of text chunks.
    """
    # Preprocess text for clean splitting
    cleaned_text = preprocess_text(text)
    words = cleaned_text.split(" ")
    chunks = []
    
    start = 0
    while start < len(words):
        end = start + chunk_size
        # Join words to form the chunk string
        chunk = " ".join(words[start:end])
        chunks.append(chunk)
        # Move the start pointer with a slight overlap to maintain context
        start += (chunk_size - overlap)
    
    return chunks

def embed_chunks(chunks: List[str]) -> List:
    """
    Generate embeddings for a list of text chunks using the initialized model.
    
    Parameters:
        chunks (List[str]): The list of text chunks.
    
    Returns:
        List: Corresponding embeddings for each chunk.
    """
    embeddings = model.encode(chunks, show_progress_bar=True)
    return embeddings

# Example usage

if __name__ == "__main__":
    sample_text = (
        "Retrieval Augmented Generation (RAG) systems combine the strengths of information retrieval "
        "with natural language generation. The goal is to first retrieve relevant documents or text chunks "
        "and then generate responses based on this contextual information. In this example, we demonstrate "
        "how to preprocess the text, split it into manageable chunks, and then compute their embeddings "
        "using a modern embedding model."
    )
    
    # Step 1: Chunk the sample text
    text_chunks = chunk_text(sample_text, chunk_size=30, overlap=5)
    print("Text Chunks:")
    for i, chunk in enumerate(text_chunks):
        printf"Chunk i+1: chunk"
    
    # Step 2: Compute embeddings for each chunk
    chunk_embeddings = embed_chunks(text_chunks)
    print("Generated Embeddings:")
    for i, emb in enumerate(chunk_embeddings):
        print(f"Embedding {i+1}: {emb[:5]}...")  # Displaying only first 5 dimensions for brevity
