package citations;

import java.util.ArrayList;
import java.util.List;

/**
 * A manager class to handle a collection of citations.
 */
public class CitationManager {
    private final List<Citation> citations;

    public CitationManager() {
        this.citations = new ArrayList<>();
    }

    /**
     * Add a citation to the list.
     * @param citation the citation to be added
     */
    public void addCitation(Citation citation) {
        if (!citations.contains(citation)) {
            citations.add(citation);
        }
    }

    /**
     * List all citations.
     * @return list of citation strings
     */
    public List<String> listCitations() {
        List<String> citationList = new ArrayList<>();
        for (Citation citation : citations) {
            citationList.add(citation.toString());
        }
        return citationList;
    }

    /**
     * Check if a citation exists in the list.
     * @param citation the citation to check
     * @return true if found, false otherwise
     */
    public boolean hasCitation(Citation citation) {
        return citations.contains(citation);
    }
    
    // Example usage of CitationManager
    public static void main(String[] args) {
        CitationManager manager = new CitationManager();

        Citation citation1 = new Citation("Doe, J.", "Understanding AI", "Journal of AI Research", 2020);
        Citation citation2 = new Citation("Smith, A.", "Proving The Answer", "International Journal of Computer Science", 2019);

        manager.addCitation(citation1);
        manager.addCitation(citation2);

        // List all the citations
        System.out.println("Citations:");
        for (String citation : manager.listCitations()) {
            System.out.println(citation);
        }

        // Verify a citation
        Citation citationToCheck = new Citation("Doe, J.", "Understanding AI", "Journal of AI Research", 2020);
        System.out.println" exists: " + manager.hasCitation(citationToCheck);
    }
}
