/**
 * Prepares a document chunk by computing the embedding and attaching metadata.
 *
 * @param text - The text chunk to be processed.
 * @param source - Identifier for the source document.
 * @param page - The page number or chunk index for reference.
 * @param embedFunction - An asynchronous function that computes the embedding vector.
 * @param extraInfo - Optional extra metadata.
 * @returns A promise that resolves to a DocumentChunk.
 */
async function createDocumentChunk(
  text: string,
  source: string,
  page: number,
  embedFunction: (input: string) => Promise<number[]>,
  extraInfo?: string
): Promise<DocumentChunk> {
  // Compute the embedding for the provided text.
  const embedding = await embedFunction(text);

  // Create metadata for this chunk.
  const metadata: ChunkMetadata = {
    source,
    page,
    timestamp: new Date().toISOString(),
    extraInfo
  };

  // Combine text, embedding, and metadata into a DocumentChunk.
  return { text, embedding, metadata };
}
