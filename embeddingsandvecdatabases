def chunk_overlap_optimal(text: str, chunk_size: int, overlap: int) -> list:
    """
    Splits the input text into overlapping chunks in an optimal manner.
    
    Args:
        text (str): The input text to be split.
        chunk_size (int): The size of each chunk in tokens.
        overlap (int): The number of tokens that overlap between consecutive chunks.
    
    Returns:
        list: A list of overlapping text chunks.
    """
    # Tokenize the input text. For better tokenization, consider using NLP libraries.
    tokens = text.split()
    
    # Validate the overlapping parameters
    if overlap >= chunk_size:
        raise ValueError("Overlap must be strictly less than chunk size.")
    
    chunks = []
    # Calculate effective step size (non-overlapping portion per chunk)
    step = chunk_size - overlap

    # Generate chunks using a sliding window approach
    index = 0
    while index < len(tokens):
        # Extract current chunk tokens
        chunk_tokens = tokens[index:index + chunk_size]
        chunks.append(" ".join(chunk_tokens))
        # Move index by the effective step
        index += step
    
    return chunks

# Example usage of optimal approach:

