def chunk_overlap_brute(text: str, chunk_size: int, overlap: int) -> list:
    """
    Splits the input text into chunks with overlap using a brute force approach.
    
    Args:
        text (str): The input text to be split.
        chunk_size (int): The desired size of each chunk (in tokens).
        overlap (int): The number of tokens to overlap between chunks.
    
    Returns:
        list: A list of text chunks.
    """
    # Convert text into tokens (for simplicity, using whitespace-based splitting)
    tokens = text.split()
    chunks = []

    # Calculate the step size
    step = chunk_size - overlap
    if step <= 0:
        raise ValueError("Overlap must be less than the chunk size.")

    # Iterate through tokens to create chunks
    for i in range(0, len(tokens), step):
        # Slice tokens from index i to i+chunk_size
        chunk = tokens[i:i + chunk_size]
        if chunk:  # Ensure chunk is non-empty
            chunks.append(" ".join(chunk))
    return chunks

