import numpy as np
import hnswlib

# Generate a dataset of 10,000 random 128-dimensional vectors

dim = 128
num_elements = 10000
data = np.random.random((num_elements, dim)).astype(np.float32)

# Initialize the HNSW index

# space 'l2' means Euclidean distance

index_hnsw = hnswlib.Index(space='l2', dim=dim)
index_hnsw.init_index(max_elements=num_elements, ef_construction=200, M=16)
index_hnsw.add_items(data)
index_hnsw.set_ef(50)  # ef parameter for controlling query time accuracy

# Query: find 5 nearest neighbors for a random vector

query_vector = np.random.random((1, dim)).astype(np.float32)
labels, distances = index_hnsw.knn_query(query_vector, k=5)

print("HNSW Query Results:")
print("Labels:", labels)
print("Distances:", distances)
IVF Example with FAISS
Copy
