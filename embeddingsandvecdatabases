embeddings = model.encode(sentences, convert_to_tensor=True)

# Calculate cosine similarity between the first sentence and others

similarities = util.cos_sim(embeddings[0], embeddings)

# Print similarity scores

print("Cosine similarity scores relative to the first sentence:")
for i, score in enumerate(similarities[0]):
    print(f"Sentence 1 and Sentence {i+1}: {score.item():.4f}")
