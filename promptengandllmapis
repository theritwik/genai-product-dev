// promptLoggerMiddleware.js
const logger = require('./logger');

/**
 * Middleware to log incoming prompt details.
 * Assumes that the prompt text is included in the request body.
 */
function promptLogger(req, res, next) {
  // Capture prompt data only if it exists in the request body
  const { prompt, userId, ...extraDetails } = req.body;
  if (prompt) {
    // Prepare the log entry with required metadata
    const logEntry = {
      timestamp: new Date().toISOString(),
      userId: userId || 'anonymous',
      prompt,
      extraDetails // additional contextual details if available
    };
    // Asynchronously log the prompt entry
    logger.info(logEntry);
  }
  next();
}

module.exports = promptLogger;
