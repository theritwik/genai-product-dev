Sample Code Implementation (Node.js)
Below is an example of a Node.js middleware integrated with an Express.js server that logs and estimates cost. In a production setting, you might enhance and secure this middleware further.

Copy
js
// server.js
const express = require('express');
const app = express();
const bodyParser = require('body-parser');

// Middleware to parse JSON request body
app.use(bodyParser.json());

// Cost configuration - define your API pricing details
const COST_PER_TOKEN = 0.00002; // Example cost per token in dollars

// Utility: Estimate token count (simple estimation: words ~ tokens)
const estimateTokenCount = (text) => {
  if (!text) return 0;
  // Adjust the logic based on your LLM's tokenization method
  return text.trim().split/+/.length;
};

// Middleware: Log prompt details and estimate cost
const promptLoggingMiddleware = async (req, res, next) => {
  const startTime = Date.now();

  // Store the original send method to intercept the response
  const originalSend = res.send.bind(res);
  res.send = (body) => {
    try {
      // Count tokens for request prompt and API response
      const promptText = req.body.prompt || '';
      const responseText = typeof body === 'string' ? body : JSON.stringify(body);
      
      const promptTokens = estimateTokenCount(promptText);
      const responseTokens = estimateTokenCount(responseText);
      const totalTokens = promptTokens + responseTokens;
      
      // Calculate estimated cost
      const estimatedCost = totalTokens * COST_PER_TOKEN;
      
      // Calculate request duration
      const duration = Date.now() - startTime;
      
      // Log details (Here we output to the console; in production, use a proper logging service)
      console.log('--- Prompt Logging ---');
      console.log('Timestamp:', new Date().toISOString());
      console.log('Prompt:', promptText);
      console.log('Response:', responseText);
      console.log('Prompt Tokens:', promptTokens);
      console.log('Response Tokens:', responseTokens);
      console.log('Total Tokens:', totalTokens);
      console.log('Estimated Cost (USD):', estimatedCost.toFixed(6));
      console.log('Request Duration (ms):', duration);
      console.log('----------------------');
      
      // Optionally, write the log data to a database or file for persistent storage
      
    } catch (error) {
      console.error('Logging middleware encountered an error:', error);
    }
    // Return the original response
    return originalSend(body);
  };

  next();
};

// Attach the logging middleware to LLM API route
app.post('/api/llm', promptLoggingMiddleware, async (req, res) => {
  try {
    // Example: Forward the request to the LLM API
    // In production, replace the following mock response with the actual LLM API call.
    const prompt = req.body.prompt;
    // Simulated response (for demonstration purposes)
    const simulatedResponse = `Simulated response for prompt: ${prompt}`;
    
    res.status(200).send(simulatedResponse);
  } catch (error) {
    res.status(500).send('Error processing LLM request.');
  }
});

// Start the server
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
