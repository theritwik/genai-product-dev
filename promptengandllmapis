package com.example.aiarchitecture;

import java.util.Optional;

// AI Dependency Interface
interface FraudDetectionAI {
    Optional<Double> getFraudRiskScore(Transaction transaction);
}

// Concrete AI Service (Stub)
class FraudDetectionAIService implements FraudDetectionAI {
    @Override
    public Optional<Double> getFraudRiskScore(Transaction transaction) {
        // Simulate AI prediction (0.0 to 1.0 risk score)
        double riskScore = Math.random(); // Replace with real AI call
        return Optional.of(riskScore);
    }
}

// Domain Model
class Transaction {
    private final String id;
    private final double amount;

    public Transaction(String id, double amount) {
        this.id = id;
        this.amount = amount;
    }

    public String getId() { return id; }
    public double getAmount() { return amount; }
}

// Decision Logic Layer
class FraudDecisionService {
    private final FraudDetectionAI aiService;
    private static final double RISK_THRESHOLD = 0.7;

    public FraudDecisionService(FraudDetectionAI aiService) {
        this.aiService = aiService;
    }

    public boolean isTransactionFraudulent(Transaction transaction) {
        Optional<Double> riskScoreOpt = aiService.getFraudRiskScore(transaction);

        if (riskScoreOpt.isEmpty()) {
            // AI unavailable, fallback to default rules
            return fallbackRule(transaction);
        }

        double riskScore = riskScoreOpt.get();

        // Business rule: block if risk score exceeds threshold
        if (riskScore > RISK_THRESHOLD) {
            return true;
        }

        // Additional business rules can be applied here
        return false;
    }

    private boolean fallbackRule(Transaction transaction) {
        // Simple fallback: block transactions over 10,000
        return transaction.getAmount() > 10000;
    }
}

// Application Entry Point
public class AIAsDependencyExample {
    public static void main(String[] args) {
        FraudDetectionAI aiService = new FraudDetectionAIService();
        FraudDecisionService decisionService = new FraudDecisionService(aiService);

        Transaction tx = new Transaction("TX123", 5000);

        boolean isFraud = decisionService.isTransactionFraudulent(tx);

        System.out.println("Transaction " + tx.getId() + " fraud status: " + (isFraud ? "BLOCKED" : "APPROVED"));
    }
}
Key Takeaways from the Code
AI Service is a dependency: FraudDetectionAIService simulates an AI model providing risk scores.
Decision logic is separate: FraudDecisionService applies thresholds and fallback rules.
Fallback mechanisms: Ensures system resilience if AI is unavailable.
Clear separation of concerns: AI is a tool, not the final authority.
