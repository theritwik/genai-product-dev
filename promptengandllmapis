// index.js
const express = require('express');
const axios = require('axios');
require('dotenv').config(); // Loads environment variables from .env

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware to parse JSON request bodies
app.use(express.json());

/**
 * POST /chat
 * Receives a JSON payload with a "prompt" field, makes an API call to the LLM endpoint,
 * and responds with the generated answer.
 */
app.post('/chat', async (req, res) => {
  try {
    const { prompt } = req.body;
    if (!prompt) {
      return res.status(400).json({ error: 'Prompt is required in the request body.' });
    }

    // Prepare the API request payload for the LLM (here using OpenAI's Chat Completions endpoint)
    const payload = {
      model: 'gpt-3.5-turbo', // Example model; update as needed
      messages: [
        {
          role: 'user',
          content: prompt
        }
      ]
    };

    // Make the API call to the external LLM endpoint
    const llmResponse = await axios.post(
      'https://api.openai.com/v1/chat/completions',
      payload,
      {
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`
        }
      }
    );

    // Extract the generated response from the LLM result
    const answer = llmResponse.data.choices[0].message.content;

    // Respond to the client with the answer
    res.json({ answer });
  } catch (error) {
    console.error('Error during LLM API call:', error.response ? error.response.data : error.message);
    res.status(500).json({ error: 'An error occurred while processing your request.' });
  }
});

// Start the server
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
