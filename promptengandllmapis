// Decision Logic Layer
class FraudDecisionService {
    private final FraudDetectionAI aiService;
    private static final double RISK_THRESHOLD = 0.7;

    public FraudDecisionService(FraudDetectionAI aiService) {
        this.aiService = aiService;
    }

    public boolean isTransactionFraudulent(Transaction transaction) {
        Optional<Double> riskScoreOpt = aiService.getFraudRiskScore(transaction);

        if (riskScoreOpt.isEmpty()) {
            // AI unavailable, fallback to default rules
            return fallbackRule(transaction);
        }

        double riskScore = riskScoreOpt.get();

        // Business rule: block if risk score exceeds threshold
        if (riskScore > RISK_THRESHOLD) {
            return true;
        }

        // Additional business rules can be applied here
        return false;
    }

    private boolean fallbackRule(Transaction transaction) {
        // Simple fallback: block transactions over 10,000
        return transaction.getAmount() > 10000;
    }
}

