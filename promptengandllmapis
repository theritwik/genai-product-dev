// Ensure that you are running Node.js version 18 or higher which has built-in fetch support.
// Otherwise, you can use a library such as "node-fetch".

// Replace with your actual OpenAI API key.
const OPENAI_API_KEY = 'your_openai_api_key_here';

// Define the OpenAI endpoint.
const endpoint = 'https://api.openai.com/v1/chat/completions';

async function getOpenAITokenUsage() {
  try {
    // Prepare the request payload. Adjust the model and messages as needed.
    const payload = {
      model: 'gpt-3.5-turbo',
      messages: [
        { role: 'system', content: 'You are a helpful assistant.' },
        { role: 'user', content: 'Provide an example of token usage response.' }
      ],
      temperature: 0.7
    };

    // Make the API call using fetch.
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${OPENAI_API_KEY}`
      },
      body: JSON.stringify(payload)
    });

    // Check for errors in the response.
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    // Parse the JSON response.
    const data = await response.json();

    // Extract the token usage details.
    // The usage object typically contains prompt_tokens, completion_tokens, and total_tokens.
    const usage = data.usage;
    if (usage) {
      console.log('Token Usage Details:');
      console.log(`Prompt Tokens: ${usage.prompt_tokens}`);
      console.log(`Completion Tokens: ${usage.completion_tokens}`);
      console.log(`Total Tokens: ${usage.total_tokens}`);
    } else {
      console.log('Token usage details are not available in the response.');
    }

    // Optionally, you can return or further process the usage object.
    return usage;
  } catch (error) {
    console.error('Error fetching OpenAI API response:', error);
  }
}

// Execute the function to get and log token usage.
getOpenAITokenUsage();
Key Points
The API response is expected to include a "usage" field in the JSON that details the number of tokens used in different parts of the transaction.
Make sure to replace "your_openai_api_key_here" with your actual OpenAI API key.
For production environments, consider additional error handling and securing your API key.
