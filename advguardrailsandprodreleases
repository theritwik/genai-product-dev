Copy
javascript
// server.js

const express = require('express');
const axios = require('axios');
const { createClient } = require('redis');
require('dotenv').config();

const app = express();
app.use(express.json());

// Environment variable extraction
const PORT = process.env.PORT || 3000;
const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
const REDIS_URL = process.env.REDIS_URL;
const CACHE_TTL = Number(process.env.CACHE_TTL) || 3600; // Time to live in seconds

// Initialize Redis client with fallback mechanism.
let redisClient;
let isRedisConnected = false;

async function initRedis() {
  try {
    redisClient = createClient({
      url: REDIS_URL,
    });
    redisClient.on('error', (err) => {
      console.error('Redis Client Error:', err);
      isRedisConnected = false;
    });
    await redisClient.connect();
    isRedisConnected = true;
    console.log('Connected to Redis.');
  } catch (error) {
    console.error('Failed to connect to Redis. Falling back to no caching:', error);
    isRedisConnected = false;
  }
}

// Function to fetch response from OpenAI using axios.
async function fetchOpenAIResponse(prompt) {
  try {
    const response = await axios.post('https://api.openai.com/v1/engines/davinci-codex/completions', {
      prompt, 
      max_tokens: 100
    }, {
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${OPENAI_API_KEY}`
      }
    });
    return response.data;
  } catch (error) {
    console.error('Error calling OpenAI API:', error.response ? error.response.data : error.message);
    throw new Error('OpenAI API call failed.');
  }
}

// API endpoint to process prompts
app.post('/prompt', async (req, res) => {
  const { prompt } = req.body;
  if (!prompt) {
    return res.status(400).json({ error: 'Prompt is required.' });
  }

  const cacheKey = `openai:${prompt}`;
  
  // Attempt to retrieve from Redis cache if available.
  if (isRedisConnected) {
    try {
      const cachedResponse = await redisClient.get(cacheKey);
      if (cachedResponse) {
        console.log('Cache hit.');
        return res.json({ source: 'cache', data: JSON.parse(cachedResponse) });
      }
      console.log('Cache miss.');
    } catch (error) {
      console.error('Error reading from Redis, proceeding without cache:', error);
    }
  } else {
    console.log('Redis unavailable, skipping cache lookup.');
  }

  // Call OpenAI API as fallback or if cache miss.
  try {
    const openAIResponse = await fetchOpenAIResponse(prompt);

    // Attempt to cache response if Redis is connected.
    if (isRedisConnected) {
      try {
        await redisClient.setEx(cacheKey, CACHE_TTL, JSON.stringify(openAIResponse));
        console.log('Response cached.');
      } catch (error) {
        console.error('Error saving to Redis cache:', error);
      }
    }

    return res.json({ source: 'openai', data: openAIResponse });
  } catch (error) {
    return res.status(500).json({ error: error.message });
  }
});

// Initialize Redis and start the Express server.
initRedis().finally(() => {
  app.listen(PORT, () => {
    console.log(`Server running on port ${PORT}.`);
  });
});
Explanation
The server uses Express to accept POST requests at the /prompt endpoint.
When a request arrives, it checks for a matching Redis cache entry.
If present, the cached response is returned. If not, the server invokes the OpenAI API.
The response from OpenAI is then stored in Redis (if possible) with a configurable time-to-live (TTL) before being returned.
Robust error handling ensures that if Redis isn’t available, the API call proceeds without interruption.
